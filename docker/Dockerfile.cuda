# GPU variant: the monbooru binary on an NVIDIA CUDA 12 + cuDNN 9 runtime
# base so the tagger can load the CUDA execution provider. The same binary runs
# on CPU when tagger.use_cuda=false, so this image works for both.

# Stage 1: build the binary. 
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN VERSION=$(cat VERSION.md 2>/dev/null | tr -d '[:space:]') && \
    REPO=$(cat REPOSITORY.md 2>/dev/null | tr -d '[:space:]') && \
    DOC=$(cat DOC.md 2>/dev/null | tr -d '[:space:]') && \
    CGO_ENABLED=1 go build -tags tagger \
    -ldflags="-s -w -X 'github.com/monbooru/monbooru/internal/web.Version=${VERSION}' -X 'github.com/monbooru/monbooru/internal/web.RepoURL=${REPO}' -X 'github.com/monbooru/monbooru/internal/web.DocURL=${DOC}' -X 'github.com/monbooru/monbooru/internal/web.Variant=cuda'" \
    -o /monbooru ./cmd/monbooru

# Stage 2: runtime -- NVIDIA CUDA 12.6 + cuDNN 9 runtime (x86_64 only).
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

# Drop the CUDA forward-compat libs (the host driver is used via the NVIDIA
# container runtime) and the apt cache.
RUN apt-get update && apt-get remove -y --purge 'cuda-compat-*' && \
    rm -rf /usr/local/cuda/compat /var/lib/apt/lists/*

# Single layer: install build-only fetch tools, pull the CUDA-enabled ORT and a
# static ffmpeg/ffprobe.
ARG ORT_VERSION=1.21.0
ARG ORT_SHA256_X64_GPU=ef37a33ba75e457aebfd0d7b342ab20424aa6126bc5f565d247f1201b66996cf
ARG FFMPEG_RELEASE=n8.1
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils && \
    curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu-${ORT_VERSION}.tgz" \
      -o /tmp/ort.tgz && \
    echo "${ORT_SHA256_X64_GPU}  /tmp/ort.tgz" | sha256sum -c - && \
    tar -xzf /tmp/ort.tgz -C /tmp && \
    cp /tmp/onnxruntime-linux-x64-gpu-${ORT_VERSION}/lib/libonnxruntime*.so* /usr/lib/ && \
    ln -sf /usr/lib/libonnxruntime.so.${ORT_VERSION} /usr/lib/libonnxruntime.so && \
    ldconfig && \
    curl -fsSL "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-${FFMPEG_RELEASE}-latest-linux64-gpl-${FFMPEG_RELEASE#n}.tar.xz" -o /tmp/ffmpeg.tar.xz && \
    mkdir -p /tmp/ff && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp/ff --strip-components=1 && \
    cp /tmp/ff/bin/ffmpeg /tmp/ff/bin/ffprobe /usr/local/bin/ && \
    apt-get purge -y curl xz-utils && apt-get autoremove -y && \
    rm -rf /tmp/onnxruntime-* /tmp/ort.tgz /tmp/ff /tmp/ffmpeg.tar.xz /var/lib/apt/lists/*

COPY --from=build /monbooru /usr/local/bin/monbooru

# Build a uid/gid 1000 "monbooru" account
RUN groupadd --gid 1000 monbooru && \
    useradd --uid 1000 --gid 1000 --home-dir /home/monbooru --create-home monbooru
USER 1000:1000

ENV MONBOORU_SERVER_BIND_ADDRESS=0.0.0.0:8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/monbooru", "healthcheck", "-config", "/config/monbooru.toml"]

ENTRYPOINT ["/usr/local/bin/monbooru", "-config", "/config/monbooru.toml"]
